# Server Configuration
PORT=3000

# Security: generate a unique value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never use the placeholder below as a real secret.
JWT_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET_BEFORE_STARTING

# Database (SQLite is the default; PostgreSQL migration is documented separately)
# DATABASE_URL=postgres://user:password@host:port/dbname
